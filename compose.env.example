# Docker Compose configuration. Use: docker compose --env-file compose.env ...
CLIENT_BIND_ADDRESS=127.0.0.1
CLIENT_HTTP_PORT=8080
RAG_PUBLIC_ORIGIN=http://localhost:8080
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
SERVER_MEMORY=8g
SERVER_CPUS=4
# Named volumes or absolute host paths. Host directories must be writable by UID 1000.
RAG_DATA_VOLUME=rag-data
RAG_MODELS_VOLUME=rag-models
RAG_BACKUPS_VOLUME=rag-backups
# For protection against primary disk failure, use a separate disk, for example:
# RAG_BACKUPS_VOLUME=/mnt/other-disk/local-rag-backups

# Reference only. Generate private .env using yarn configure or yarn configure --production.
POSTGRES_ADMIN_PASSWORD=replace
POSTGRES_APP_PASSWORD=replace
REDIS_PASSWORD=replace
S3_ACCESS_KEY=local-rag
S3_SECRET_KEY=replace
APP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
NODE_ENV=production
AI_ALLOWED_ENDPOINTS=
ALLOW_TEST_AI=0
DEFAULT_GENERATION_PROVIDER=google
DEFAULT_EMBEDDING_PROVIDER=google
DOCKER_PUBLIC_ORIGIN=https://rag.example.com
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_VERSION=dev
SERVER_MEMORY=1g
SERVER_CPUS=2
INDEX_MEMORY=2g
ANSWER_CONCURRENCY=4
INDEX_CONCURRENCY=2
PROCESSING_CONCURRENCY=1

# Optional Docker local inference; use yarn configure --local-ai for a new installation.
LOCAL_AI=0
DOCKER_OLLAMA_URL=http://ollama:11434
OLLAMA_MEMORY=6g
OLLAMA_CPUS=6
DEFAULT_TRANSCRIPTION_PROVIDER=
OLLAMA_PORT=11435

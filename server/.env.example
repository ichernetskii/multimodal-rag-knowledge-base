# Relative storage and cache paths resolve within server/. Docker uses absolute paths.
RAG_DATA_DIR=./data
# Optional backup target on a different disk:
# RAG_BACKUP_DIR=/mnt/local-rag-backups
RAG_HOST=127.0.0.1
RAG_PORT=3210
# CLI connects to 127.0.0.1:RAG_PORT; override for a remote installation:
# RAG_URL=https://rag.example.internal
# Optional CLI bearer token; otherwise use login and the local session file:
# RAG_TOKEN=your-token
# Exact browser origin behind a reverse proxy:
# RAG_PUBLIC_ORIGIN=https://rag.example.internal
# TRUST_PROXY=1

# Local model runtime. Preparing weights may require internet; normal work does not.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
EMBEDDING_CACHE=./.cache/models
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_TOKENS=2048
EMBEDDING_BATCH_SIZE=16
EMBEDDING_THREADS=4
CHUNK_TOKENS=256
CHUNK_MAX_CHARACTERS=4096
CHUNK_OVERLAP=32
# CONTEXT_MAX_CHARACTERS=12000
# LLM_CONTEXT_TOKENS=8192
# LLM_MAX_OUTPUT_TOKENS=512
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_KEEP_ALIVE=5m
# MODEL_DOWNLOAD_TIMEOUT_MS=600000

# PDF / local OCR runtime prepared by yarn prepare:pdf:
# PREPARE_PYTHON=python3
# PDF_PYTHON=./.venv/bin/python3
# OCR_VISION_BIN=./.cache/ocr-vision

# Startup uses effective runtime settings stored by this version of the app.
# For an intentional model/index configuration change, set this to 0, then reindex.
# RAG_USE_SAVED_CONFIG=0
# Limits, topK, retention, OCR and backup schedules are managed through UI/API.

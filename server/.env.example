# Use yarn configure; passwords and signing key are generated, never commit the resulting .env.
NODE_ENV=development
DATABASE_URL=postgres://rag_app:replace@127.0.0.1:5432/rag
DATABASE_ADMIN_URL=postgres://postgres:replace@127.0.0.1:5432/rag
REDIS_URL=redis://:replace@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=rag
S3_ACCESS_KEY=local-rag
S3_SECRET_KEY=replace
APP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
AI_ALLOWED_ENDPOINTS=
ALLOW_TEST_AI=1
DEFAULT_GENERATION_PROVIDER=test
DEFAULT_EMBEDDING_PROVIDER=test
RAG_HOST=127.0.0.1
RAG_PORT=3210
RAG_PUBLIC_ORIGIN=http://localhost:5173
ANSWER_CONCURRENCY=4
INDEX_CONCURRENCY=2
PROCESSING_CONCURRENCY=1

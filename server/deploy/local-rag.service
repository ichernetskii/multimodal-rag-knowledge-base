[Unit]
Description=Local RAG API and background workers
After=network.target ollama.service

[Service]
Type=simple
User=local-rag
Group=local-rag
WorkingDirectory=/opt/local-rag
EnvironmentFile=/opt/local-rag/server/.env
ExecStart=/usr/bin/node /opt/local-rag/server/dist/interfaces/cli/main.js serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/local-rag /mnt/local-rag-backups /opt/local-rag/server/.cache
MemoryMax=8G
CPUQuota=400%
UMask=0077

[Install]
WantedBy=multi-user.target

SQLITE_PATH=./data/rag.sqlite
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_TOKENS=2048
EMBEDDING_BATCH_SIZE=16
TOKENIZER_CACHE=./.cache/tokenizers
CHUNK_TOKENS=256
CHUNK_MAX_CHARACTERS=4096
CHUNK_OVERLAP=32
TOP_K=5
# SCORE_THRESHOLD is optional: similarity is not the probability of a correct answer.
# SCORE_THRESHOLD=0.4
# General settings: src/config.ts; adapters: src/runtime-config.ts; model: src/model-profiles/embeddinggemma.ts.
# CONTEXT_MAX_CHARACTERS=12000
# LLM_CONTEXT_TOKENS=8192
# LLM_MAX_OUTPUT_TOKENS=512
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_KEEP_ALIVE=5m

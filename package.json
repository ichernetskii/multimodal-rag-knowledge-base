{
  "name": "local-rag",
  "description": "Multi-tenant knowledge SaaS with PostgreSQL, pg-boss, S3, Redis and replaceable AI providers",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node tooling/dev.ts",
    "dev:client": "yarn workspace @local-rag/client dev",
    "dev:server": "yarn workspace @local-rag/server dev",
    "cli": "yarn workspace @local-rag/server cli",
    "build": "yarn build:client && yarn build:server",
    "build:client": "yarn workspace @local-rag/client build",
    "build:server": "yarn workspace @local-rag/server build",
    "start": "node tooling/start.ts",
    "typecheck": "tsc --noEmit && yarn workspace @local-rag/server typecheck && yarn workspace @local-rag/client typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "yarn workspace @local-rag/server test && yarn workspace @local-rag/client test",
    "validate": "yarn docs:check && yarn contracts:check && yarn typecheck && yarn lint && yarn format:check && yarn test && yarn build",
    "prepare:pdf": "yarn workspace @local-rag/server prepare:pdf",
    "contracts:generate": "node tooling/contracts.ts",
    "contracts:check": "node tooling/contracts.ts --check",
    "docs:check": "node tooling/check-docs.ts",
    "configure": "node tooling/configure.ts",
    "start:server": "yarn workspace @local-rag/server start",
    "start:client": "yarn workspace @local-rag/client start",
    "prepare:media": "yarn workspace @local-rag/server prepare:media",
    "test:docker": "node tooling/test-docker.ts",
    "infra:up": "node tooling/infra.ts up",
    "infra:down": "node tooling/infra.ts down",
    "dev:reset": "node tooling/infra.ts reset",
    "seed": "yarn cli seed",
    "test:integration": "yarn workspace @local-rag/server test:integration",
    "docker:up": "node tooling/infra.ts app",
    "docker:down": "node tooling/infra.ts app-down",
    "installation:backup": "node --import tsx tooling/installation.ts backup",
    "installation:restore": "node --import tsx tooling/installation.ts restore",
    "demo:import": "node --import tsx tooling/import-demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "jiti": "2.6.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
